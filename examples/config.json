{
  "hideControlStrip": true,
  "default": [
    { "type": "button", "symbol": "terminal", "action": { "type": "launch", "app": "com.apple.Terminal" } },
    { "type": "button", "symbol": "safari", "action": { "type": "launch", "app": "com.apple.Safari" } },
    { "type": "image", "image": "sample.gif", "width": 60 },
